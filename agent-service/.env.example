LIVEAVATAR_API_KEY=replace_me
LIVEAVATAR_BASE_URL=https://api.liveavatar.com
LIVEAVATAR_AVATAR_ID=replace_me
LIVEAVATAR_AVATAR_ID_2=replace_me
LIVEAVATAR_AVATAR_ID_3=replace_me
LIVEAVATAR_SANDBOX=false
LIVEAVATAR_MAX_SESSION_DURATION=60

LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# The agent uses the existing Cloudflare OpenAI-compatible proxy so every turn
# keeps the current risk-specific retrieval and Groq grounding behavior.
LLM_PROXY_BASE_URL=https://replace-me.example.workers.dev/openai/v1
LLM_PROXY_TOKEN=replace_me
GROQ_MODEL=openai/gpt-oss-120b

# LiveKit inference gateway models used for speech recognition and speech synthesis.
STT_MODEL=deepgram/nova-3
TTS_MODEL=cartesia/sonic-3
TTS_VOICE_ID=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
TTS_VOICE_ID_2=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
TTS_VOICE_ID_3=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc

# Must match the Cloudflare Worker secret LITE_AGENT_SHARED_SECRET.
AGENT_SHARED_SECRET=replace_with_a_long_random_value
PORT=8080
LOG_LEVEL=INFO
